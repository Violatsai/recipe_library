# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Local Postgres (Homebrew postgresql@18). No user/password = trust auth for your macOS user.
DATABASE_URL=postgres://localhost:5432/recipes

# Anthropic — enrichment + agent (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Voyage AI — embeddings only (dashboard.voyageai.com; 200M free tokens)
VOYAGE_API_KEY=pa-...

# YouTube Data API v3 — video title/description (console.cloud.google.com)
YOUTUBE_API_KEY=AIza...

# Shared secret guarding POST /api/ingest. Any long random string (openssl rand -hex 24).
# Keep it alphanumeric to avoid shell-quoting surprises.
INGEST_API_KEY=change-me

PORT=3001
