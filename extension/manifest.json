{
  "manifest_version": 3,
  "name": "Recipe Library",
  "version": "0.1.0",
  "description": "Save recipes from any web page or YouTube video to your personal recipe library.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save recipe"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"]
}
